{
  "name": "@v2-ecosystem/simulation",
  "version": "1.0.0",
  "description": "Multi-Actor Real-Time Simulation System for V2 Ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "run:normal": "ts-node scripts/run-scenario.ts normal",
    "run:lunch": "ts-node scripts/run-scenario.ts lunch",
    "run:conference": "ts-node scripts/run-scenario.ts conference",
    "run:stress": "ts-node scripts/run-scenario.ts stress",
    "run:weekend": "ts-node scripts/run-scenario.ts weekend",
    "test:race": "ts-node scripts/inventory-race.ts"

  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "simulation",
    "hospitality",
    "testing",
    "bots",
    "actors"
  ],
  "author": "V2 Ecosystem Team",
  "license": "PROPRIETARY"
}
