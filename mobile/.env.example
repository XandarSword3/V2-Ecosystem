# ============================================
# V2 Ecosystem — Mobile App Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Expo reads EXPO_PUBLIC_* vars automatically.
# ============================================

# API connection (your backend server)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

# Stripe (publishable key only — NEVER put secret key in mobile app)
# Get from: https://dashboard.stripe.com/test/apikeys
EXPO_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.v2ecosystem

# Supabase (anon key only — NEVER put service key in mobile app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Feature flags
EXPO_PUBLIC_IS_DEV=true
