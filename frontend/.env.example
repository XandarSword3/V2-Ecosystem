NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
NEXT_PUBLIC_APP_NAME=V2 Ecosystem

# Install wizard kill switch — defaults to disabled. Only set to 'true' for
# a genuine self-hosted first-boot install. Leave unset/false on Vercel.
NEXT_PUBLIC_INSTALL_ENABLED=false

# Error Tracking (optional - leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
