# ===========================
# V2 Ecosystem — .gitignore
# ===========================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment files (secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.test
supabase.env
**/supabase.env
**/.env
**/.env.local
**/.env.test
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Keep template / example env files tracked
!*.env.example
!**/*.env.example
!*.env.example*
!**/*.env.example*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
coverage-*/
.nyc_output/
test-results/
test-results*.json
playwright-report/
/reports/
strategic-analysis/
screenshots/
frontend/coverage/
frontend/coverage-critical/
coverage-output.txt

# Test outputs & temp files
*test-output.txt
*errors.txt
*failures.txt
*results.json
backend/output.txt
backend/errors-only.txt
backend/vitest-backend-output.txt
schema_analysis.json
audit-detail.txt
audit-full.txt
legacy_audit_detail*.txt
legacy_audit_report.txt
push_error.log

# Misc
*.tgz
*.bak
.cache/

# Security-sensitive files
*.plist
google-services.json
auth-token.json
.ci_*.json
.ci_*.txt
.ci_*.log
.ci_*.utf8.log
.ci_service_probe.log
push_error.log
*_error.log
.tmp_*
**/dist-android/
**/archive/**/*.txt
**/_archive/**/*.txt
tools/*.json
!tools/legacy-audit-baseline.json
reports/*.json
screenshots/*.png
screenshots/**/*.png
screenshots/**/*.jpg

# Archived data
archive/

# Root-level scratch text
/*.txt

# One-off scripts (agent-generated)
add_keys.js
refactor_economics.js
*.agent.js

# Agent scratch space & schema dumps
scratch/
schema_dump.sql
.aider*
