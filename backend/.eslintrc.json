{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
        "@typescript-eslint"
    ],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "env": {
        "node": true,
        "es6": true
    },
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "rules": {
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_"
            }
        ],
        "@typescript-eslint/ban-ts-comment": "warn",
        "@typescript-eslint/no-require-imports": "off",
        "no-console": [
            "warn",
            {
                "allow": [
                    "warn",
                    "error",
                    "info"
                ]
            }
        ],
        "prefer-const": "warn",
        "no-useless-escape": "warn",
        "no-case-declarations": "warn",
        "no-useless-catch": "warn",
        "no-prototype-builtins": "warn",
        "no-restricted-syntax": [
            "error",
            {
                "selector": "MemberExpression[computed=true] > Literal[value='x-tenant-id']",
                "message": "Do not read the x-tenant-id header directly for an authorization/ownership decision — it is attacker-controlled (any authenticated caller can set it to any value). Use getCallerTenantId()/requireTenantScope() from src/security/tenant-scope.ts instead. See remediation plan Phase 0/1. (tenantAccess.middleware.ts is the one legitimate exception, exempted below.)"
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "src/middleware/tenantAccess.middleware.ts"
            ],
            "rules": {
                "no-restricted-syntax": "off"
            }
        }
    ]
}