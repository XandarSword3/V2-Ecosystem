{
  "name": "@v2-ecosystem/backend",
  "version": "1.0.0",
  "private": true,
  "license": "PROPRIETARY",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--import ./src/instrumentation.ts\" tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=\"--import ./dist/instrumentation.js\" node dist/index.js",
    "keep-alive": "tsx src/scripts/keep-alive.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts",
    "db:reset": "tsx src/database/reset.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:setup": "docker-compose -f docker-compose.test.yml up -d && timeout 10",
    "test:integration:teardown": "docker-compose -f docker-compose.test.yml down -v",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint src --ext .ts",
    "check:tenant-writes": "node scripts/check-tenant-scoped-writes.js",
    "lint:fix": "eslint src --ext .ts --fix",
    "test:smoke": "node scripts/api-smoke-test.js"
  },
